stmt  level    source

    1          #include <STC32G.H>
    2          #include "intrins.h"
    3          #define MAIN_Fosc        24000000UL   //定义主时钟
    4          
    5          sbit LED_L=P3^4;    //重定义左前车灯LED
    6          sbit LED_R=P0^5;    //重定义右前车灯LED
    7          
    8          /********************* 函数声明 *************************/ 
    9          
   10          void delay_ms(unsigned char ms); 
   11          
   12          /********************* 主函数 *************************/
   13          void main()
   14          {
   15   1         WTST = 0;  //设置程序指令延时参数，赋值为0可将CPU执行指令的速度设置为最快
   16   1         EAXFR = 1; //扩展寄存器(XFR)访问使能
   17   1         CKCON = 0; //提高访问XRAM速度
   18   1        
   19   1         P3M0 = 0x10;        //将P3.4口单独设置为推挽输出模式  0001 0000
   20   1         P3M1 = 0x00;
   21   1        
   22   1         P0M0 = 0x20;        //将P0.5口单独设置为推挽输出模式  0010 0000
   23   1         P0M1 = 0x00;
   24   1        
   25   1         while (1)
   26   1        {
   27   2          LED_L=1;        //高电平点亮左前车灯
   28   2          LED_R=1;        //高电平点亮右前车灯
   29   2          delay_ms(200);  //延时200ms
   30   2          delay_ms(200);  //延时200ms
   31   2          LED_L=0;        //低电平熄灭左前车灯
   32   2          LED_R=0;        //低电平熄灭右前车灯
   33   2          delay_ms(200);  //延时200ms
   34   2          delay_ms(200);  //延时200ms
   35   2        }
   36   1      } 
   37          
   38          
   39          //========================================================================
   40          // 函数: void delay_ms(u8 ms)
   41          // 描述: 延时函数。
   42          // 参数: ms,要延时的ms数, 这里只支持1~255ms. 自动适应主时钟.
   43          // 返回: none.
   44          // 版本: VER1.0
   45          // 日期: 2022-9-24
   46          // 备注: 
   47          //========================================================================
   48          void delay_ms(unsigned char ms)
   49          {
   50   1          unsigned int  i;
   51   1          do{
   52   2              i = MAIN_Fosc / 6000;
   53   2              while(--i);   //6T per loop
   54   2          }while(--ms);
   55   1      }
   56          
   57          

