   41   1        
   42   1          while (1)
   43   1          {   
   44   2      /*********************************按键检测*******************************************************/        
   45   2              if(KEY==0)
   46   2              {
   47   3                delay_ms(20);   //20ms防抖检测
   48   3                if(KEY==0)      //再次检测按键情况
   49   3                { 
   50   4                  if(++model_Number>2)
   51   4                  {
   52   5                     model_Number=0;
   53   5                  } 
   54   4                }
   55   3                while(KEY==0);  //等待松开
   56   3              } 
   57   2          
   58   2      /*********************************汽车前进*******************************************************/ 
