    1          #include "timer.h"    
    2          #include "motor.h" 
    3          /*--------------------------------------------------------------*/
    4          /* --- -----------------实验内容 -------------------------------*/
    5          /* --- 1-了解STC-ISP工具生产延时函数方法 -----------------------*/
    6          /* --- 2-掌握子函数的创建与调用---------------------------------*/
    7          /* --- 实验平台：未来电子STC32核心板----------------------------*/
    8          /* --- 视频学习：https://space.bilibili.com/494969171 ----------*/
    9          /* --- QQ交流群：702805632 -------------------------------------*/
   10          /* --- 参考资料：STC32实验室参考例程 ---------------------------*/
   11          /*--------------------------------------------------------------*/ 
   12          
   13          uint16 Time_Count = 0; 
   14          uint8 Time_Count_pwm = 0; 
   15          uint8 PWM_Count = 50; //占空比
   16          
   17          /***********************************************************
   18          功能描述：定时器4初始化  1MS
   19          入口参数：无
   20          返回值：无
   21          ************************************************************/
   22          void Timer4Init(void)
   23          {
   24   1        T4T3M &= 0xBF;                  //定时器4设置为定时方式
   25   1        T4T3M |= 0x20;                  //设置定时器4为1T模式
   26   1        T4L = 0x90;                     //1T模式下初始装载值 
   27   1        T4H = 0xE8;                     //1T模式下初始装载值 
   28   1        IE2  |=  (1<<6);                //使能定时器4中断
   29   1        T4T3M |= 0x80;                  //打开定时器4
   30   1      } 
   31          /***********************************************************
   32          功能描述：定时器4中断服务程序
   33          入口参数：无
   34          返回值：无       250us进入1次中断 
   35          ************************************************************/
   36          void timer4_int (void) interrupt 20
   37          {
   38   1        if(++Time_Count>=4000) //最长计时间 
   39   1        {
   40   2           Time_Count=0;
   41   2        }  
   42   1        if(++Time_Count_pwm>100)
   43   1         {
   44   2            Time_Count_pwm=0;
   45   2         } 
   46   1         if(Time_Count_pwm>=PWM_Count)//PWM调速
   47   1         {
   48   2            Car_Stop(); //置为低电平     
   49   2         }else{    
   50   2      
   51   2           Adjust_Pwm_data(); //置为高电平
   52   2         } 
   53   1      } 
   54          
   55          /*********************************END FILE********************************************/ 
