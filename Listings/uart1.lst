   95          void Uart_Send_ADC_data(unsigned int  ADC_DATA)
   96          {
   97   1          unsigned char temp=0,temp1=0,temp2=0,temp3=0;
   98   1        
   99   1             temp=(ADC_DATA/1000)+'0'; 
  100   1             temp1=(ADC_DATA/100%10)+'0'; 
  101   1             temp2=(ADC_DATA/10%10)+'0';
  102   1             temp3=(ADC_DATA%10)+'0';
  103   1      
  104   1             PrintString1("SR04:");
  105   1             SendDataByUart1(temp);
  106   1             SendDataByUart1(temp1 );
  107   1             SendDataByUart1(temp2);
  108   1             SendDataByUart1(temp3);    
  109   1             PrintString1(" CM\r\n");     
  110   1      }
