   12          #define MAIN_Fosc        24000000UL   //定义主时钟 
   13          
   14          //========================================================================
   15          // 函数: void delay_ms(u8 ms)
   16          // 描述: 延时函数。
   17          // 参数: ms,要延时的ms数, 这里只支持1~255ms. 自动适应主时钟.
   18          // 返回: none.
   19          // 版本: VER1.0
   20          // 日期: 2022-9-24
   21          // 备注: 
   22          //========================================================================
   23          void delay_ms(unsigned char ms)
   24          {
   25   1          unsigned int  i;
   26   1          do{
   27   2              i = MAIN_Fosc / 6000;
   28   2              while(--i);   //6T per loop
   29   2          }while(--ms);
   30   1      }
